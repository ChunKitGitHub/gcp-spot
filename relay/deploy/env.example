# newspot-relay 运行配置。复制为 /etc/newspot-relay/env 后配置。

# Spot Agent 心跳认证 Token（必须与 spot-agent 上的 AGENT_TOKEN 一致）
AGENT_TOKEN=change_this_to_a_strong_agent_token

# 控制台与 Admin API 认证 Token（登录 Web UI 或调用 API 凭证）
ADMIN_TOKEN=change_this_to_a_strong_admin_token

# 公网 VLESS 入口配置
VLESS_LISTEN=:443
# TLS 模式："acme"（默认，公网域名自动申请证书）或 "none"（内网明文 TCP）
TLS_MODE=acme
TLS_DOMAIN=tw.example.com
ACME_EMAIL=ops@example.com

# 管理 API / Web UI / 心跳监听地址（Spot 与管理员需能访问，例如 GCP 内网 0.0.0.0:9090）
ADMIN_LISTEN=0.0.0.0:9090

# 状态存储文件
DATA_PATH=/var/lib/newspot-relay/state.json

# 供 Spot 节点自动下载 agent 二进制的本地目录
AGENT_BINARY_DIR=/var/lib/newspot-relay/bin

# 故障转移与心跳参数 (可选)
# HEARTBEAT_TIMEOUT=30s
# FAILBACK_STABLE=60s
# SPOT_RETENTION=72h
# MAX_BACKUP_SLOTS_PER_SPOT=2
# PORT_RANGE_START=20000
# PORT_RANGE_END=20999
